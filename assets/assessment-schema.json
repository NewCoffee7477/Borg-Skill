{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:borg:assessment-schema:3.1",
  "$comment": "Structural interchange schema. scripts/validate_assessment.py is the normative Borg acceptance validator for semantic, source-safety, adapter, correlation, accounting, authority, and consequence rules. Version 3 remains a clean break and does not accept or migrate version 2 collaboration records; version 3.1 requires an explicit untrusted-source safety record.",
  "title": "Borg Assessment Structural Sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "date", "mode", "source", "scope", "source_safety", "coverage", "capabilities", "candidates", "risks", "contradictions", "collaboration", "definition_of_done"],
  "properties": {
    "assessment_id": {"type": "string", "pattern": "^BORG-A-[0-9]{8}-[0-9]{3,}$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "mode": {"enum": ["broad-reconnaissance", "targeted-transfer", "placement-analysis", "redundancy-review", "candidate-planning", "controlled-execution", "reassessment", "recurring-discovery"]},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["name", "snapshot"],
      "properties": {"name": {"type": "string", "minLength": 1}, "snapshot": {"type": "string", "minLength": 1}, "canonical_refs": {"type": "array", "items": {"type": "string"}}}
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["target", "in_scope", "out_of_scope", "execution_authorized"],
      "properties": {"target": {"type": ["string", "null"]}, "in_scope": {"type": "array", "items": {"type": "string"}}, "out_of_scope": {"type": "array", "items": {"type": "string"}}, "execution_authorized": {"type": "boolean"}}
    },
    "source_safety": {
      "type": "object", "additionalProperties": false,
      "required": ["trust_state", "instruction_boundary_applied", "indicator_scan", "inspection_gaps", "dynamic_execution"],
      "properties": {
        "trust_state": {"const": "untrusted"},
        "instruction_boundary_applied": {"const": true},
        "indicator_scan": {
          "type": "object", "additionalProperties": false, "required": ["state", "reason", "evidence_refs"],
          "properties": {
            "state": {"enum": ["not-run", "no-indicators", "indicators", "unavailable"]},
            "reason": {"type": ["string", "null"]},
            "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        },
        "inspection_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dynamic_execution": {
          "type": "object", "additionalProperties": false,
          "required": ["requested", "authorized", "authorization_ref", "executed", "isolation_state", "network_state", "credentials_exposed", "evidence_refs"],
          "properties": {
            "requested": {"type": "boolean"},
            "authorized": {"type": "boolean"},
            "authorization_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^(user|host):\\S.+$"}]},
            "executed": {"type": "boolean"},
            "isolation_state": {"enum": ["not-applicable", "enforced", "unavailable", "failed"]},
            "network_state": {"enum": ["not-applicable", "disabled", "allowlisted", "unknown"]},
            "credentials_exposed": {"type": "boolean"},
            "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false, "required": ["evidence_surfaces", "saturated", "limitations"],
      "properties": {"evidence_surfaces": {"type": "array", "items": {"type": "string"}}, "saturated": {"type": "boolean"}, "limitations": {"type": "array", "items": {"type": "string"}}}
    },
    "capabilities": {
      "type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["capability_id", "normalized_name", "evidence_grade", "confidence"],
      "properties": {"capability_id": {"type": "string", "pattern": "^CAP-[0-9]{3,}$"}, "normalized_name": {"type": "string", "minLength": 1}, "evidence_grade": {"enum": ["E0", "E1", "E2", "E3", "E4"]}, "confidence": {"enum": ["low", "medium", "high"]}}
    }},
    "candidates": {
      "type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["candidate_id", "classification", "capability", "destination", "assimilation_form", "hard_gates_pass", "robustness", "confidence", "evidence_refs", "next_action"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^BORG-[PSN][0-9]{3,}$"}, "classification": {"enum": ["primary", "secondary", "do-not-assimilate"]}, "capability": {"type": "string", "minLength": 1}, "destination": {"type": ["string", "null"]},
        "assimilation_form": {"enum": ["configure", "compose", "extend", "optional-mode", "plugin-adapter", "shared-service-library", "upstream-contribution", "fork", "new-skill-component", "external", "defer", "reject"]},
        "reason_codes": {"type": "array", "items": {"enum": ["DUP", "DOM", "EXT", "INC", "COST", "RISK", "IRR", "IMM", "LOCK", "EXCL", "DEFER"]}},
        "hard_gates_pass": {"type": "boolean"}, "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100}, "score_range": {"type": ["array", "null"], "prefixItems": [{"type": "number", "minimum": 0, "maximum": 100}, {"type": "number", "minimum": 0, "maximum": 100}], "minItems": 2, "maxItems": 2},
        "robustness": {"enum": ["robust", "moderately-robust", "unstable", "not-assessed"]}, "confidence": {"enum": ["low", "medium", "high"]}, "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "promotion_test": {"type": ["string", "null"]}, "next_action": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"candidate_id": {"pattern": "^BORG-P"}}}, "then": {"properties": {"classification": {"const": "primary"}}}},
        {"if": {"properties": {"candidate_id": {"pattern": "^BORG-S"}}}, "then": {"properties": {"classification": {"const": "secondary"}}}},
        {"if": {"properties": {"candidate_id": {"pattern": "^BORG-N"}}}, "then": {"properties": {"classification": {"const": "do-not-assimilate"}}}}
      ]}
    },
    "risks": {"type": "array", "items": {"type": "string"}},
    "contradictions": {"type": "array", "items": {"type": "string"}},
    "collaboration": {
      "type": "object", "additionalProperties": false, "required": ["envelope_version", "checks"],
      "properties": {
        "envelope_version": {"const": "3.0"},
        "checks": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/collaboratorCheck"}}
      }
    },
    "definition_of_done": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["pass", "fail", "not-applicable", "bounded-limitation"]}}
  },
  "$defs": {
    "collaboratorCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["skill_id", "discovery", "contract", "applicability", "lifecycle", "consequence", "adapter"],
      "properties": {
        "skill_id": {"enum": ["subagent-swarm", "doctrine-parliamentarian"]},
        "discovery": {"type": "object", "additionalProperties": false, "required": ["state", "checked_at", "evidence_refs"], "properties": {"state": {"enum": ["present", "absent", "unknown"]}, "checked_at": {"type": "string", "minLength": 1}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
        "contract": {"anyOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["source", "version_or_hash", "inspected_at"], "properties": {"source": {"type": "string", "minLength": 1}, "version_or_hash": {"type": "string", "minLength": 1}, "inspected_at": {"type": "string", "minLength": 1}}}]},
        "applicability": {"type": "object", "additionalProperties": false, "required": ["state", "reason", "authority_ref"], "properties": {"state": {"enum": ["required", "eligible", "not-applicable", "unknown"]}, "reason": {"type": "string", "minLength": 1}, "authority_ref": {"type": ["string", "null"]}}},
        "lifecycle": {"type": "object", "additionalProperties": false, "required": ["state", "native_status", "execution_mode", "result_state", "accounted", "blocker", "evidence_refs"], "properties": {"state": {"enum": ["not-started", "running", "complete", "degraded", "blocked", "unavailable", "failed"]}, "native_status": {"type": ["string", "null"]}, "execution_mode": {"type": ["string", "null"]}, "result_state": {"enum": ["none", "partial", "terminal"]}, "accounted": {"type": "boolean"}, "blocker": {"type": ["string", "null"]}, "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
        "consequence": {"type": "object", "additionalProperties": false, "required": ["state", "affected_outputs", "reason", "authority_ref"], "properties": {"state": {"enum": ["none", "scope-limited", "blocked"]}, "affected_outputs": {"type": "array", "items": {"type": "string", "minLength": 1}}, "reason": {"type": ["string", "null"]}, "authority_ref": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^(user|host|legal|safety):\\S.+$"}]}}},
        "adapter": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/swarmAdapter"}, {"$ref": "#/$defs/doctrineAdapter"}]}
      }
    },
    "swarmAdapter": {
      "type": "object", "additionalProperties": false, "required": ["adapter_id", "adapter_version", "agent_path", "parent_lane", "tier", "subtree_accounted", "result_evidence_refs"],
      "properties": {"adapter_id": {"const": "borg.subagent-swarm"}, "adapter_version": {"const": "1.0"}, "agent_path": {"type": "string", "minLength": 1}, "parent_lane": {"type": ["string", "null"]}, "tier": {"type": "integer", "minimum": 0}, "subtree_accounted": {"type": "boolean"}, "result_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}}
    },
    "doctrineAdapter": {
      "type": "object", "additionalProperties": false, "required": ["adapter_id", "adapter_version", "reviews"],
      "properties": {"adapter_id": {"const": "borg.doctrine-parliamentarian"}, "adapter_version": {"const": "1.0"}, "reviews": {"type": "array", "items": {"$ref": "#/$defs/doctrineReceipt"}}}
    },
    "doctrineReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["review_id", "phase_id", "phase", "native_status", "gate_state", "disposition", "superseded_by_phase_id", "source_completeness", "confidence", "result_received", "accounted", "blocker", "evidence_ref"],
      "properties": {"review_id": {"type": "string", "minLength": 1}, "phase_id": {"type": "string", "minLength": 1}, "phase": {"enum": ["plan", "pre-action", "execution", "response", "full-docket"]}, "native_status": {"type": ["string", "null"]}, "gate_state": {"enum": ["satisfied", "unsatisfied", "invalid-docket"]}, "disposition": {"enum": ["current", "superseded"]}, "superseded_by_phase_id": {"type": ["string", "null"]}, "source_completeness": {"enum": ["COMPLETE", "ISSUE_COMPLETE_CORPUS_PARTIAL", "INCOMPLETE"]}, "confidence": {"enum": ["low", "medium", "high"]}, "result_received": {"type": "boolean"}, "accounted": {"type": "boolean"}, "blocker": {"type": ["string", "null"]}, "evidence_ref": {"type": "string", "minLength": 1}}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "controlled-execution"}}},
      "then": {"properties": {"scope": {"properties": {"execution_authorized": {"const": true}}}}}
    }
  ]
}
